# ==============================================================================
# FMS Environment Configuration Template
# Copy this file to .env and configure for your deployment environment
# ==============================================================================

# Application Environment: 'production' or 'development'
APP_ENV=production
APP_DEBUG=false

# Base URL (Optional, leave blank to auto-detect from web server hostname)
# Example: https://fms.gmrit.edu.in
BASE_URL=

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gmrdufms
DB_USER=root
DB_PASS=

# Session Lifetime (seconds, default 0 = until browser closes)
SESSION_LIFETIME=0

# Session Inactivity Timeout (seconds, default 7200 = 2 hours)
SESSION_TIMEOUT=7200

